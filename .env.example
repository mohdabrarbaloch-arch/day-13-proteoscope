# Proteoscope — environment variables
# Copy to .env and adjust. The defaults below work for local development.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# development | production. In production the app refuses to start with a
# default or short SECRET_KEY, or with DEBUG on.
ENVIRONMENT=development

# Verbose error output. Must be false in production.
DEBUG=false

# Signing key for JWTs. MUST be changed in production — at least 32 random
# characters. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me

# Token lifetime in minutes. Default is 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Any SQLAlchemy URL.
#   SQLite (default, zero setup):   sqlite:///./proteoscope.db
#   PostgreSQL:                     postgresql+psycopg2://user:pass@host:5432/proteoscope
# On Vercel/Lambda a SQLite URL is redirected to /tmp automatically, because
# the filesystem is read-only elsewhere.
DATABASE_URL=sqlite:///./proteoscope.db

# ---------------------------------------------------------------------------
# Engine limits
# ---------------------------------------------------------------------------

# The contact step is O(n^2), so this is a real ceiling, not a formality.
# 2000 residues is ~2M pair evaluations. Raising it much further will make
# requests slow enough to time out.
MAX_SEQUENCE_LENGTH=2000

# Below this, a prediction is not meaningful.
MIN_SEQUENCE_LENGTH=10

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Comma-separated list of allowed origins. Never use * in production.
CORS_ORIGINS=http://localhost:8013,http://127.0.0.1:8013

# Rate limits, per client IP, per path prefix. Format: <count>/<second|minute|hour>
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_PREDICT=30/minute
RATE_LIMIT_DEFAULT=120/minute